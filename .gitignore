__pycache__/
*.pyc

# P3-002 FIX: Make gitignore consistent — ignore generated artifacts but keep .gitkeep for demo
# Generated models and CSVs are ignored for git to keep repo small, but kept locally for demo run.
# The six inference models the API needs at runtime are committed (small, ~9 MB total) so the
# Vercel function can score without a training step; all other model artifacts stay ignored.
missionmind/models/*.joblib
!missionmind/models/iforest.joblib
!missionmind/models/iforest_power.joblib
!missionmind/models/iforest_thermal.joblib
!missionmind/models/scaler.joblib
!missionmind/models/scaler_power.joblib
!missionmind/models/scaler_thermal.joblib
missionmind/models/*.pkl
missionmind/models/features.txt
missionmind/data/*.csv
missionmind/data/scenario_manifest.json
!missionmind/data/.gitkeep
!missionmind/models/.gitkeep

.venv/
node_modules/
.env
.freebuff/

# Keep comparison report and grounded params (JSON) even though models ignored
!missionmind/models/comparison_report.json
!missionmind/data/grounded_parameters.json
!missionmind/data/nasa_battery_sample.csv

# Real NASA PCoE battery data (55 MB, re-downloadable - see missionmind/docs/NASA_REAL_VALIDATION.md)
missionmind/data/real_nasa/*.mat
# NASA C-MAPSS turbofan RUL data (re-downloadable - see missionmind/docs/RUL_PROGNOSTICS.md)
missionmind/data/real_nasa/_cmapss/

# ---- tooling / local-only ------------------------------------------------
.pytest_cache/
.agents/
web/dist/
uploads/
*.log

# Runtime session state written by the dashboard on every run (not source)
missionmind/data/last_session.json

# Auth database (users/sessions/tokens) — local state, never committed
missionmind/data/missionmind.db
missionmind/data/missionmind.db-wal
missionmind/data/missionmind.db-shm

# Demo pipeline intermediates (deleted on success; ignored so a crashed run
# can't leave phantom diffs behind)
demo/missionmind_demo_raw.mp4
demo/audio/_mix.m4a

# OS / editor / tool droppings
.DS_Store
Thumbs.db
*.tmp
*.bak
*.orig
.coverage
htmlcov/

.vercel

# Banner export � local only, never committed
bannerdownload/

# Build output
/dist/

# Personal banner (not for repo)
missionmind-banner-1920x600.png
missionmind-logo-512.png

# Personal images (not for repo)
images-*.png

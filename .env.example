# ============================================================================
# MissionMind environment template — copy to `.env` (never commit `.env`).
# No secrets are required: the app runs fully in demo mode without any of
# the optional credentials below.
# ============================================================================

# ---- IBM watsonx.ai — for real Granite (optional; deterministic mock works
# ---- without any of these and is always labelled "mock", never masquerades)
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Current IBM deploy-on-demand Granite model (Granite 4 hybrid instruct).
# Override per region/account — the app reports which model it uses.
WATSONX_MODEL_ID=ibm/granite-4-h-small

# ---- Auth (the FastAPI backend has real multi-user auth; local demo works
# ---- with ZERO configuration — verification/reset tokens are returned in
# ---- dev mode because no SMTP is wired)
# SQLite database file for users/sessions/tokens. Default:
#   missionmind/data/missionmind.db   (gitignored)
# MISSIONMIND_DB_PATH=

# Environment mode. Leave unset for development/demo (cookies not Secure,
# verification tokens returned in responses). Set to "production" for
# deployments: HttpOnly cookies become Secure, HSTS is sent, and
# verification/reset tokens are NEVER returned — wire real email delivery.
# MISSIONMIND_ENV=production
# Alternative to MISSIONMIND_ENV for just the cookie flag:
# MISSIONMIND_SECURE_COOKIES=1

# Bootstrap admin account (created email-verified on startup if absent).
# MISSIONMIND_ADMIN_EMAIL=
# MISSIONMIND_ADMIN_PASSWORD=

# ---- CORS: deployed browser origins allowed to call the FastAPI backend
# ---- (comma-separated). Default (unset) allows only local dev origins:
# ---- Streamlit :8501, Vite :5173, API :8100. Set your Vercel URL when
# ---- deployed, e.g.:
# MISSIONMIND_ALLOWED_ORIGINS=https://missionmind.vercel.app

# ---- Tunables (rarely needed) ---------------------------------------------
# Session lifetime in seconds (default 604800 = 7 days).
# MISSIONMIND_SESSION_TTL_S=604800
# Email verification token lifetime (default 86400 = 24 h).
# MISSIONMIND_VERIFY_TTL_S=86400
# Password reset token lifetime (default 3600 = 1 h).
# MISSIONMIND_RESET_TTL_S=3600
# Auth rate limits (per IP / per IP+email; defaults below).
# MISSIONMIND_AUTH_SIGNUP_LIMIT=5            # / 15 min per IP
# MISSIONMIND_AUTH_LOGIN_LIMIT=10            # / 5 min per (IP,email)
# MISSIONMIND_AUTH_LOGIN_IP_LIMIT=30         # / 5 min per IP
# MISSIONMIND_AUTH_VERIFY_LIMIT=10           # / 10 min per IP
# MISSIONMIND_AUTH_RESEND_LIMIT=3            # / 15 min per (IP,email)
# MISSIONMIND_AUTH_RESET_LIMIT=5             # / 15 min per (IP,email)
# MISSIONMIND_AUTH_RESET_CONFIRM_LIMIT=10    # / 10 min per IP
# Per-user mission-API request caps (/ min).
# MISSIONMIND_API_LIMIT=240
# MISSIONMIND_API_EXPENSIVE_LIMIT=60         # /api/models, /api/live/next
# PBKDF2 iterations (default 310000 — do not lower in production).
# MISSIONMIND_PBKDF2_ITERATIONS=310000

# ---- Real IBM smoke test (only when credentials are set — never in CI) ----
#   .venv/Scripts/python.exe -m missionmind.ai.granite_client --check
# It makes ONE real watsonx call and FAILS (exit 1) if IBM does not answer;
# it never substitutes the mock, so a pass proves real Granite worked.

[TEMPLATE]
# IBM watsonx.ai - for real Granite (optional, mock works without)
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Current IBM deploy-on-demand Granite model (Granite 4 hybrid instruct).
# Override per region/account — the app reports which model it uses.
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Deployed browser origins allowed to call the FastAPI backend (comma-separated).
# Default (unset) allows only local dev origins: Streamlit :8501, Vite :5173,
# API :8100. Set this to your Vercel URL when deployed, e.g.:
# MISSIONMIND_ALLOWED_ORIGINS=https://missionmind.vercel.app

# No other env needed — Three.js via CDN, NASA data public domain
# pip install: pip install -r requirements.txt
# which installs: pandas numpy scikit-learn joblib streamlit plotly ibm-watsonx-ai python-dotenv pyod xgboost
#
# Real IBM smoke test (only when credentials are set — never in CI):
#   .venv/Scripts/python.exe -m missionmind.ai.granite_client --check
# It makes ONE real watsonx call and FAILS (exit 1) if IBM does not answer;
# it never substitutes the mock, so a pass proves real Granite worked.
